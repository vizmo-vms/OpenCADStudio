{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convert-candidates.schema.json",
  "title": "SecurePlan CAD bridge protocol v1: conversion candidates (CNV-02)",
  "description": "World millimetres after block transforms and the stored mapping. Walls: one candidate per straight segment. Route: one ordered connected path. rejected lists parts the desktop refused, with a location.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "walls", "rejected"],
      "properties": {
        "kind": { "const": "walls" },
        "walls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": { "$ref": "common.schema.json#/$defs/pointMm" },
              "end": { "$ref": "common.schema.json#/$defs/pointMm" }
            }
          }
        },
        "rejected": { "$ref": "#/$defs/rejected" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "points", "rejected"],
      "properties": {
        "kind": { "const": "route" },
        "points": { "type": "array", "minItems": 2, "maxItems": 10000, "items": { "$ref": "common.schema.json#/$defs/pointMm" } },
        "rejected": { "$ref": "#/$defs/rejected" }
      }
    }
  ],
  "$defs": {
    "rejected": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "atMm"],
        "properties": {
          "reason": { "enum": ["gap", "branch", "tooShort", "pointsTooClose", "unsupportedCurve"] },
          "atMm": { "$ref": "common.schema.json#/$defs/pointMm" }
        }
      }
    }
  }
}
